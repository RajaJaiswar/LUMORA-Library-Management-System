# ========================================================
# LUMORA Backend Environment Configuration
# ========================================================
# Copy this file to .env or set these environment variables in your system:
# On Windows (PowerShell):
#   $env:JWT_SECRET="your-generated-base64-secret"
#   $env:DB_PASSWORD="your_mysql_password"
# On Linux / macOS (bash):
#   export JWT_SECRET="your-generated-base64-secret"
#   export DB_PASSWORD="your_mysql_password"

# --------------------------------------------------------
# 1. JWT Security Configuration (MANDATORY)
# --------------------------------------------------------
# Production requirement: At least 32 cryptographically random bytes (256 bits of entropy).
# Note: 32 arbitrary ASCII characters do NOT provide 256 bits of entropy (~190 bits).
# Use 32 raw random bytes encoded as Base64 (44 characters) or Hex (64 characters).
#
# Generate 32 cryptographically secure random bytes (Base64 encoded):
#   Linux / macOS:
#     openssl rand -base64 32
#   Windows PowerShell:
#     $b = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=your_32_byte_random_secret_base64_or_hex_encoded_min_32_bytes

# --------------------------------------------------------
# 2. MySQL Database Configuration
# --------------------------------------------------------
DB_PASSWORD=your_mysql_password_here
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/library_management

# --------------------------------------------------------
# 3. Server Configuration (Optional defaults)
# --------------------------------------------------------
SERVER_PORT=8081
APP_SETUP_REGENERATE_TOKEN=false
